# Formal check of the PIO tile's AXI4-Lite port with ZipCPU's faxil_slave ([SPEC-AXI-04], [SPEC-VER-01]).
#   cd tests/formal && sby -f pio_tile_axil.sby bmc     # bounded, 40 clocks (reset alone takes 16)
#   cd tests/formal && sby -f pio_tile_axil.sby prove   # k-induction (unbounded)
# The induction invariants are in pio_tile_axil.sv (`ifdef FORMAL), stated on the tile ports only.
[tasks]
bmc
prove

[options]
bmc: mode bmc
bmc: depth 40
prove: mode prove
prove: depth 40
multiclock off

[engines]
smtbmc yices

[script]
read -formal faxil_slave.v
read -sv asp_pio_sm.sv asp_pio_tile.sv
read -formal pio_tile_axil.sv
prep -top pio_tile_axil

[files]
../../third_party/wb2axip/bench/formal/faxil_slave.v
../../src/rtl/asp_pio_sm.sv
../../src/rtl/asp_pio_tile.sv
pio_tile_axil.sv
